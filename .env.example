# --- API ---
KERN_ANAHTAR=            # doluysa her istek `x-kern-anahtar` başlığında bunu taşımalı
KERN_CORS=*              # virgülle izinli origin'ler

# --- UYAP Bedesten (içtihat + mevzuat) ---
ICTIHAT_ARALIK_SN=       # istekler arası bekleme; boş = varsayılan (~10 istek / 30 sn / IP)
# isteğe bağlı proxy havuzu, her IP kendi hız kovasını alır (bkz. kern/bedesten.py başlığı)
ICTIHAT_PROXY_HOST=
ICTIHAT_PROXY_USER=
ICTIHAT_PROXY_PASS=

# --- Yapay zekâ (yalnız /ictihat/sorgu-oner ve /ozet/*) ---
DeepSeekAPI=
GEMINI_API_KEY=
LLM_TABAN=
LLM_MODEL=
LLM_API_KEY=
